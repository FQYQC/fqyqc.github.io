# Hugo build output
/public/
/resources/_gen/
/resources/_cache/

# Local asset library (also self-ignored by assets/local-assets/.gitignore)
/assets/local-assets/

# Claude Code local settings and preview config (machine-specific paths)
/.claude/settings.local.json
/.claude/launch.json

# Python bytecode from scripts/
__pycache__/

# Local scratch files for post processing; never publish these
/tmp.txt
/L001/
# Hugo copies non-Markdown files under content/ into the site verbatim
/content/**/*.py

# OS junk files
.DS_Store
.AppleDouble
.LSOverride

# Syncthing
.stfolder
.stignore
**.sync-conflict**

# Thumbnails
._*

# Hugo cache
hugo_stats.json

# VSCode settings
.vscode/

# Node modules (if using npm/yarn for assets)
/node_modules/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup files
*~
*.swp
*.swo

# Hugo specific
.hugo_build.lock
.hugo_build.lock.tmp

# Mac specific
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Mac finder
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Hugo archetypes (optional - uncomment if you don't want to track archetype templates)
# archetypes/

# Hugo content drafts (optional - uncomment if you don't want to track draft content)
# content/**/draft.md
# content/**/_draft.md

# Hugo data files (optional - uncomment if you don't want to track data files)
# data/

# Hugo layouts (optional - uncomment if you don't want to track custom layouts)
# layouts/

# Hugo static files (optional - uncomment if you don't want to track static files)
# static/

# Hugo themes (optional - uncomment if you don't want to track themes)
# themes/

# Hugo config files (optional - uncomment if you don't want to track config files)
# config.toml
# config.yaml
# config.json


# Web-sized post images made by scripts/optimize_images.py, uploaded to the image host by hand
/optimized-images/
